{
  "name": "markdown-organizer",
  "version": "1.3.0",
  "description": "Desktop app for managing AI-generated Markdown documents",
  "author": {
    "name": "DIMBD-AKE",
    "email": "dream70521@gmail.com"
  },
  "homepage": "https://github.com/DIMBD-AKE/Markdown-Organizer",
  "repository": {
    "type": "git",
    "url": "https://github.com/DIMBD-AKE/Markdown-Organizer"
  },
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "npm run typecheck:web",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "start": "vite preview --host 127.0.0.1",
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "build": "npm run typecheck && tauri build",
    "build:mac": "npm run typecheck && tauri build --bundles app,dmg",
    "build:win": "npm run typecheck && tauri build --bundles nsis",
    "build:linux": "npm run typecheck && tauri build --bundles appimage",
    "release:local": "node scripts/release-local.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.2.8",
    "@fontsource/geist": "^5.2.9",
    "@shikijs/rehype": "^1.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-virtual": "^3.0.0",
    "@tauri-apps/api": "^2.11.1",
    "github-slugger": "^2.0.0",
    "mermaid": "^11.0.0",
    "path-browserify": "^1.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "shiki": "^1.29.2",
    "unified": "^11.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.14.5",
    "@types/path-browserify": "^1.0.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^1.0.0",
    "playwright": "^1.44.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.2",
    "vite": "^7.3.6",
    "vitest": "^1.0.0"
  }
}
